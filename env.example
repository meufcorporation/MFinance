# MFinance Environment Variables
# Copy this file to .env and update the values

# Database
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_USER=mfinance_user

# Redis
REDIS_PASSWORD=your_secure_redis_password

# RabbitMQ
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=your_secure_rabbitmq_password

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your_secure_minio_password

# Grafana
GRAFANA_PASSWORD=your_secure_grafana_password
GRAFANA_SECRET_KEY=your_grafana_secret_key

# Django
SECRET_KEY=your_django_secret_key_here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# NextAuth
NEXTAUTH_URL=https://yourdomain.com
NEXTAUTH_SECRET=your_nextauth_secret_key

# Keycloak
KEYCLOAK_ISSUER=https://yourdomain.com/realms/mfinance
KEYCLOAK_CLIENT_ID=mfinance-web
KEYCLOAK_CLIENT_SECRET=your_keycloak_client_secret

# API
NEXT_PUBLIC_API_URL=https://yourdomain.com/api

# Email (for notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password

# SMS (for notifications)
SMS_PROVIDER=twilio
SMS_ACCOUNT_SID=your_twilio_account_sid
SMS_AUTH_TOKEN=your_twilio_auth_token
SMS_FROM_NUMBER=+1234567890

# Bank Integration
MONO_API_URL=https://api.monobank.ua
MONO_CLIENT_ID=your_mono_client_id
MONO_CLIENT_SECRET=your_mono_client_secret

PRIVAT_API_URL=https://api.privatbank.ua
PRIVAT_CLIENT_ID=your_privat_client_id
PRIVAT_CLIENT_SECRET=your_privat_client_secret

# Tax Integration
DPS_API_URL=https://cabinet.tax.gov.ua
DPS_CLIENT_ID=your_dps_client_id
DPS_CLIENT_SECRET=your_dps_client_secret

# Digital Signature
KEP_SDK_URL=https://sdk.kep.gov.ua
KEP_CLIENT_ID=your_kep_client_id
KEP_CLIENT_SECRET=your_kep_client_secret

# Monitoring
ENABLE_OTEL=True
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_ENDPOINT=http://localhost:9090

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Security
ENABLE_MFA=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
